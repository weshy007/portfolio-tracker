# Application
APP_NAME=Portfolio Tracker
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./app.db

# Currency API Configuration
# Use exchangerate-api.com or similar service
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest
CURRENCY_API_KEY=your_api_key_here
CURRENCY_CACHE_MINUTES=60
MANSA_API_KEY=
MANSA_API_URL=https://mansaapi.com/api/v1
PESACALC_MMF_URL=https://pesacalc.co.ke/calculators/money-market

MANSA_API_KEY='api_key_here'

# Default currency for new users
DEFAULT_CURRENCY=KES

# CORS origins (comma-separated for production)
CORS_ORIGINS=*

# Comma-separated hosts accepted in production
TRUSTED_HOSTS=["localhost","127.0.0.1"]
